# Atlas data environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored.
#
# The standard local-dev path is to bootstrap atlas_db via UIS:
#   ./uis configure postgresql --app atlas --database atlas_db --json
# That command creates the database, generates an `atlas` Postgres role,
# and auto-exposes the service at localhost:35432. Copy `username`,
# `password`, and `local.database_url` (with localhost, not host.docker.internal)
# from the JSON output into the matching variables below.
#
# See website/docs/contributors/setup.md for the full walkthrough.

# Used by ingest modules (TypeScript → raw.*) and the migration runner.
# From the host machine, use localhost; from inside a UIS-provisioned
# container, use postgresql.default.svc.cluster.local.
DATABASE_URL=postgresql://atlas:<password>@localhost:35432/atlas_db

# Standard libpq env vars — used by dbt's profiles.yml and by psql without
# arguments. Keep these in sync with DATABASE_URL above.
PGHOST=localhost
PGPORT=35432
PGUSER=atlas
PGPASSWORD=<password>
PGDATABASE=atlas_db

# Required by scraping ingests (e.g. ingest:redcross-branches) — embedded in
# the User-Agent so site operators can reach you if a scrape causes problems.
# Hard-fails the scrape if unset; not needed for SSB/FHI/Brreg API ingests.
ATLAS_SCRAPE_CONTACT_EMAIL=you@example.org
