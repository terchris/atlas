# Atlas data environment configuration.
# Copy to `.env` and fill in. `.env` is gitignored.

# Used by ingest modules (TypeScript → raw.*) and the migration runner.
# From the macOS host, use localhost; from a Dagster pod inside the cluster,
# use the service DNS name (e.g. postgresql.default.svc.cluster.local).
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Standard libpq env vars — used by dbt's profiles.yml and by psql without
# arguments. Keep these in sync with DATABASE_URL above.
PGHOST=localhost
PGPORT=5432
PGUSER=user
PGPASSWORD=password
PGDATABASE=dbname
