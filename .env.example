# Atlas Next.js — local environment configuration.
# Copy to `.env.local` and fill in. `.env.local` is gitignored.

# Read-only Postgres role with SELECT on marts.*. The frontend never writes.
# For local dev against the same Postgres that atlas-data-repo uses, the
# full-access user works; for production create a dedicated SELECT-only role.
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
