# Atlas customer frontend — environment configuration.
# Copy to `.env.local` (gitignored) for local dev.
#
# This app is a PostgREST consumer. It has NO direct Postgres access:
# no DATABASE_URL, no postgres.js dependency, no DB role. Only the
# HTTP API URL below.
#
# For Atlas's local rancher-desktop dev cluster, use `http://api-atlas.localhost`.
# For your own deployment of Atlas (or a fork pointing at your own PostgREST),
# set this to your API base URL — anything PostgREST 12+ exposes works.

NEXT_PUBLIC_API_URL=http://api-atlas.localhost
